# Copy this file to `sms/.env` and fill it in.
#
# Nothing here is optional except the gateway URL: without credentials the
# notifier cannot text anyone, and without the token it cannot reach the app.

# ---- SMS Gateway for Android (the app on your phone) ----
#
# Install `app-release.apk` (in this folder) on the phone, sign in to your
# account in the app, then open its "Cloud server" / account screen — the
# username and password shown there are what go below. The phone must stay
# online and the app running for messages to leave the queue.
#
# Rotate these if they were ever committed or shared: whoever holds them can
# send SMS through your phone.
SMS_GATEWAY_USERNAME=
SMS_GATEWAY_PASSWORD=

# The gateway's cloud API. Only change it when you run the gateway in local
# server mode, in which case use the address the app shows on your network,
# e.g. http://192.168.1.20:8080/api/3rdparty/v1
SMS_GATEWAY_URL=https://sms.capcom.me/api/3rdparty/v1

# ---- EduVoice app ----
#
# Where the notifier asks for the tasks that have just come due. Point this at
# your deployment (https://… ) when the app is not running on this machine.
EDUVOICE_URL=http://localhost:3000

# Shared secret for /api/tasks/reminders. Generate one, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# and put the SAME value in the app's own `.env` (see the root .env.example).
TASK_REMINDER_TOKEN=

# ---- The clock the texts are dated by (optional) ----
#
# Minutes, exactly as JavaScript's getTimezoneOffset() reports them: -480 for
# Asia/Manila, 300 for New York in winter. Leave it empty and the notifier reads
# the machine's own clock, which is what you want when it runs on the student's
# machine — php.ini is deliberately not trusted, because a stock XAMPP ships
# date.timezone=Europe/Berlin and would put the wrong hour in every text. Set it
# only to pin a timezone, e.g. when the app runs somewhere else and the texts
# should follow a different clock.
NOTIFY_TZ_OFFSET_MINUTES=
