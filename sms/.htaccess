# Access rules for the sms folder when it is served by Apache (XAMPP).
#
# The built-in PHP server is the recommended way to serve this folder because
# sms/serve.php locks it down in code; with Apache these rules do the same job.
# Without them, requesting /.env returns the gateway username and password.

# Dot-files: .env (credentials), .env.example, .htaccess itself.
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Non-PHP data files that should never be downloadable.
<FilesMatch "\.(apk|json|lock|md|sql|log)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Include-only folders. Their PHP would be served as source, which leaks code
# (not secrets, but nothing here needs to be reachable).
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(lib|vendor)/ - [F,L]
</IfModule>
