# Copy this file to `.env` and fill in your connection strings.

# ---- Database ----

# Neon (cloud) — create a project at https://console.neon.tech and copy the
# "Pooled connection" string from the dashboard.
# DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Local Postgres (managed with pgAdmin) — default superuser from the
# Postgres installer. Create a database named `eduvoice` first.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/eduvoice

# ---- Clerk (https://dashboard.clerk.com → API Keys) ----

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard
# Webhook signing secret — Clerk Dashboard → Webhooks → endpoint signing secret
CLERK_WEBHOOK_SECRET=

# ---- Gemini (Google AI Studio: https://aistudio.google.com/app/apikey) ----

GEMINI_API_KEY=
# Optional: gemini-3.6-flash (default) | gemini-3.6-pro | gemini-2.5-flash (existing accounts only)
GEMINI_MODEL=gemini-3.6-flash

# ---- Gemini TTS ("Listen" button, free tier) ----
# Model: gemini-3.1-flash-tts-preview (default) | gemini-2.5-flash-preview-tts | gemini-2.5-pro-preview-tts
# Voice: any of the 30 prebuilt voices, e.g. Sulafat (warm), Achird (friendly), Kore (firm)
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Sulafat