# Copy this file to `.env` and fill in your connection strings.

# ---- Database ----

# Neon (cloud) — create a project at https://console.neon.tech and copy the
# "Pooled connection" string from the dashboard.
# DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Local Postgres (managed with pgAdmin) — default superuser from the
# Postgres installer. Create a database named `eduvoice` first.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/eduvoice

# ---- Clerk (https://dashboard.clerk.com → API Keys) ----

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard
# Webhook signing secret — Clerk Dashboard → Webhooks → endpoint signing secret
CLERK_WEBHOOK_SECRET=

# ---- Gemini (Google AI Studio: https://aistudio.google.com/app/apikey) ----
# Free-tier quota is per account AND per model, so add the keys of up to three
# separate AI Studio accounts. Requests rotate across them, and a key that runs
# out of quota is parked while another serves — for chat replies and for TTS
# alike. Duplicates are ignored, and a single key still works on its own.
#
# Note the per-model daily cap (20 requests/day on gemini-3.6-flash at the time
# of writing) — one chat message or one generated quiz spends one request, so a
# single key runs dry quickly. GEMINI_MODEL_FALLBACKS below is what keeps the app
# answering once the primary model's daily allowance is gone.

GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# Optional: gemini-3.6-flash (default) | gemini-3.6-pro | gemini-2.5-flash (existing accounts only)
GEMINI_MODEL=gemini-3.6-flash

# Models tried in order when the one above has spent its daily quota. Each model
# has its own free allowance, so listing sibling models here multiplies the usable
# requests per day at no cost. Comma-separated. Confirm a name against
# https://ai.google.dev/gemini-api/docs/models — an unavailable one fails with a
# 404 ("not found for API version").
GEMINI_MODEL_FALLBACKS=gemini-3.7-flash,gemini-3.8-flash

# ---- Gemini TTS ("Listen" button, free tier) ----
# Model: gemini-3.1-flash-tts-preview (default) | gemini-2.5-flash-preview-tts | gemini-2.5-pro-preview-tts
# Voice: must be one of the voices listed in src/features/chat/lib/voices.ts, otherwise
# the default applies. EduVoice speaks with Puck.
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Puck

# ---- Task reminder texts ----
# Students save a mobile number on the Tasks page and get one SMS the moment a
# task's day and time arrives. The sending itself lives in `sms/` (it has to run
# through the SMS Gateway app on the phone, whose only client is PHP), so the
# notifier authenticates to the app with this shared secret instead of a Clerk
# session:
#
#   GET  /api/tasks/reminders        tasks just come due, with the text to send
#   POST /api/tasks/reminders        "these were handed to the gateway"
#
# Generate one with
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# and put the same value in `sms/.env`. Leave it empty to switch the endpoint
# off entirely (it answers 401 to everything). See sms/README.md to schedule the
# notifier.
TASK_REMINDER_TOKEN=

# Where the `sms` folder is served, used by the Tasks page's "Send test text"
# button. Start that folder with:
#
#   php -S 127.0.0.1:8081 -t sms sms/serve.php
#
# (the router keeps .env, the vendor folder and everything else unserved — see
# sms/README.md). Under XAMPP/Apache this is usually
# http://localhost/sms/send.php instead.
SMS_SEND_URL=http://127.0.0.1:8081/send.php
