# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# Local data: question audio dropped onto a room quiz
# (data/quiz-audio/<roomId>/) and the runtime speech cache (data/speech/).
# data/phrases/ is the pre-generated voice-mode phrase bank — committed on
# purpose, so a fresh clone speaks those lines without spending TTS quota.
/data/*
!/data/phrases/

# production
/build

# misc
.DS_Store
*.pem

# What each scheduled run of the SMS notifier did (see sms/README.md)
/sms/notify.log

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
